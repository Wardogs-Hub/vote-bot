# Copy this file to .env and fill it in. Never share .env or commit it.

# Discord bot token (Developer Portal > your application > Bot > Reset Token)
DISCORD_TOKEN=

# Your Discord server ID (right-click the server with Developer Mode on > Copy Server ID)
GUILD_ID=

# ID of the reward role (right-click the role in Server Settings > Roles > Copy Role ID)
ROLE_ID=

# Your WardogsHub API key, starts with wdh_ (see the README)
WARDOGSHUB_API_KEY=

# Where members vote: your server page on WardogsHub
VOTE_URL=https://wardogshub.gg/servers/your-server-slug/

# Hours the role lasts after a claim. 0 = never remove it.
ROLE_HOURS=24

# Automatic mode: every this many minutes the bot checks for new votes and gives
# the role to voters who are in your server. 0 = off (members use /claimvote).
AUTO_POLL_MINUTES=5
